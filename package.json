{
    "name": "lmautocomplete",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "bin": {
        "a": "dist/cli/index.js"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "start": "node dist/cli/index.js",
        "dev": "tsx src/cli/index.ts",
        "check": "tsc -p tsconfig.json --noEmit",
        "test": "tsx tests/testRunner.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "chalk": "^5.3.0",
        "js-yaml": "^4.1.0",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^22.13.1",
        "prettier": "^3.6.2",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3"
    }
}
