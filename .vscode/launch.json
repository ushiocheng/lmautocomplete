{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "CLI: Prompt (TS)",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "node",
            "runtimeArgs": ["--import", "tsx"],
            "program": "${workspaceFolder}/src/cli/index.ts",
            "args": ["${input:cliPrompt}"],
            "env": {
                "FORCE_COLOR": "1"
            },
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "CLI: Prompt + Debug + Dry Run (TS)",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "node",
            "runtimeArgs": ["--import", "tsx"],
            "program": "${workspaceFolder}/src/cli/index.ts",
            "args": ["--debug", "--dry-run", "${input:cliPrompt}"],
            "env": {
                "FORCE_COLOR": "1"
            },
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "CLI: Configurator",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "node",
            "runtimeArgs": ["--import", "tsx"],
            "program": "${workspaceFolder}/src/cli/index.ts",
            "args": ["--config"],
            "env": {
                "FORCE_COLOR": "1"
            },
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Tests Runner",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "node",
            "runtimeArgs": ["--import", "tsx"],
            "program": "${workspaceFolder}/tests/testRunner.ts",
            "env": {
                "FORCE_COLOR": "1",
                "LMA_TEST_WORKERS": "20",
                "LMA_TEST_RATE_LIMIT_MS": "100"
            },
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": ["<node_internals>/**"]
        }
    ],
    "inputs": [
        {
            "id": "cliPrompt",
            "type": "promptString",
            "description": "Instruction to run through CLI",
            "default": "ping 1.1.1.1"
        }
    ]
}